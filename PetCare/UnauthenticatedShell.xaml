<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PetCare.UnauthenticatedShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PetCare"
    xmlns:page="clr-namespace:PetCare.Page"
    Title="PetCare"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate page:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Register"
        ContentTemplate="{DataTemplate page:RegisterPage}"
        Route="RegisterPage" />

</Shell>
