<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PetCare.ViewModel"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:model="clr-namespace:PetCare.Model"
             xmlns:converter="clr-namespace:PetCare.Converter"
             x:Class="PetCare.Page.Admin.ManageUsers"
             x:DataType="vm:ManageUsersViewModel"
             Title="Control Center - Users"
             BackgroundColor="#FFFDFB">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Core Theme Colors -->
            <Color x:Key="PrimaryOrange">#FF8200</Color>
            <Color x:Key="SecondaryOrange">#FFA500</Color>
            <Color x:Key="TextDark">#2D2D2D</Color>
            <Color x:Key="TextGray">#757575</Color>
            <Color x:Key="BorderOrange">#FFE4CC</Color>
            <Color x:Key="CreamWhite">#FFF9F2</Color>

            <!-- Stat Card Style -->
            <Style x:Key="StatFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="BorderColor" Value="{StaticResource BorderOrange}" />
            </Style>

            <!-- User Card Style -->
            <Style x:Key="UserGridFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="BorderColor" Value="{StaticResource BorderOrange}" />
                <Setter Property="MinimumHeightRequest" Value="320" />
                <Setter Property="HorizontalOptions" Value="Fill" />
            </Style>

            <!-- Action Icon Button -->
            <Style x:Key="CircleActionBtn" TargetType="Button">
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="BackgroundColor" Value="#FFF5E6" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryOrange}" />
                <Setter Property="FontFamily" Value="PoppinsBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="DesktopState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="HeaderPanel" Property="Padding" Value="40,30,40,10" />
                        <Setter TargetName="StatsGrid" Property="Padding" Value="40,10" />
                        <Setter TargetName="StatsGrid" Property="ColumnDefinitions" Value="*, *, *, *" />
                        <Setter TargetName="StatsGrid" Property="RowDefinitions" Value="Auto" />
                        <Setter TargetName="StatCard1" Property="Grid.Row" Value="0" />
                        <Setter TargetName="StatCard1" Property="Grid.Column" Value="0" />
                        <Setter TargetName="StatCard2" Property="Grid.Row" Value="0" />
                        <Setter TargetName="StatCard2" Property="Grid.Column" Value="1" />
                        <Setter TargetName="StatCard3" Property="Grid.Row" Value="0" />
                        <Setter TargetName="StatCard3" Property="Grid.Column" Value="2" />
                        <Setter TargetName="StatCard4" Property="Grid.Row" Value="0" />
                        <Setter TargetName="StatCard4" Property="Grid.Column" Value="3" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="TabletState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="HeaderPanel" Property="Padding" Value="30,20,30,10" />
                        <Setter TargetName="StatsGrid" Property="Padding" Value="30,10" />
                        <Setter TargetName="StatsGrid" Property="ColumnDefinitions" Value="*, *" />
                        <Setter TargetName="StatsGrid" Property="RowDefinitions" Value="Auto, Auto" />
                        <Setter TargetName="StatCard1" Property="Grid.Row" Value="0" />
                        <Setter TargetName="StatCard1" Property="Grid.Column" Value="0" />
                        <Setter TargetName="StatCard2" Property="Grid.Row" Value="0" />
                        <Setter TargetName="StatCard2" Property="Grid.Column" Value="1" />
                        <Setter TargetName="StatCard3" Property="Grid.Row" Value="1" />
                        <Setter TargetName="StatCard3" Property="Grid.Column" Value="0" />
                        <Setter TargetName="StatCard4" Property="Grid.Row" Value="1" />
                        <Setter TargetName="StatCard4" Property="Grid.Column" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MobileState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="HeaderPanel" Property="Padding" Value="20,15,20,5" />
                        <Setter TargetName="StatsGrid" Property="Padding" Value="20,5" />
                        <Setter TargetName="StatsGrid" Property="ColumnDefinitions" Value="*" />
                        <Setter TargetName="StatsGrid" Property="RowDefinitions" Value="Auto, Auto, Auto, Auto" />
                        <Setter TargetName="StatCard1" Property="Grid.Row" Value="0" />
                        <Setter TargetName="StatCard1" Property="Grid.Column" Value="0" />
                        <Setter TargetName="StatCard2" Property="Grid.Row" Value="1" />
                        <Setter TargetName="StatCard2" Property="Grid.Column" Value="0" />
                        <Setter TargetName="StatCard3" Property="Grid.Row" Value="2" />
                        <Setter TargetName="StatCard3" Property="Grid.Column" Value="0" />
                        <Setter TargetName="StatCard4" Property="Grid.Row" Value="3" />
                        <Setter TargetName="StatCard4" Property="Grid.Column" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <RefreshView Command="{Binding LoadUsersCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Spacing="0" Padding="0,0,0,40">
                    <!-- 1. PAGE HEADER -->
                    <Grid x:Name="HeaderPanel" ColumnDefinitions="*, Auto" Padding="20,20,20,10">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="User Management" FontSize="32" FontFamily="PoppinsBold" TextColor="{StaticResource TextDark}" />
                            <Label Text="Global system administration &amp; account control" 
                                   TextColor="{StaticResource TextGray}" FontSize="15" FontFamily="PoppinsRegular" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 2. STATISTIC CARDS -->
                    <Grid x:Name="StatsGrid" ColumnSpacing="20" RowSpacing="20" Padding="20,10">
                        <Frame x:Name="StatCard1" Style="{StaticResource StatFrame}">
                            <HorizontalStackLayout Spacing="15">
                                <Frame HeightRequest="48" WidthRequest="48" CornerRadius="24" BackgroundColor="#FFF5E6" Padding="12" HasShadow="False" BorderColor="Transparent">
                                    <Image Source="users_icon.png" Aspect="AspectFit" />
                                </Frame>
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="Total Accounts" FontSize="12" TextColor="{StaticResource TextGray}" FontFamily="PoppinsRegular" />
                                    <Label Text="{Binding TotalUsersCount}" FontSize="22" FontFamily="PoppinsBold" TextColor="{StaticResource TextDark}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>

                        <Frame x:Name="StatCard2" Grid.Column="1" Style="{StaticResource StatFrame}">
                            <HorizontalStackLayout Spacing="15">
                                <Frame HeightRequest="48" WidthRequest="48" CornerRadius="24" BackgroundColor="#E8F5E9" Padding="12" HasShadow="False" BorderColor="Transparent">
                                    <Label Text="🛡" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Frame>
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="Administrators" FontSize="12" TextColor="{StaticResource TextGray}" FontFamily="PoppinsRegular" />
                                    <Label Text="{Binding TotalAdminsCount}" FontSize="22" FontFamily="PoppinsBold" TextColor="#2E7D32" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>

                        <Frame x:Name="StatCard3" Grid.Column="2" Style="{StaticResource StatFrame}">
                            <HorizontalStackLayout Spacing="15">
                                <Frame HeightRequest="48" WidthRequest="48" CornerRadius="24" BackgroundColor="#E3F2FD" Padding="12" HasShadow="False" BorderColor="Transparent">
                                    <Label Text="👤" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Frame>
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="Clients" FontSize="12" TextColor="{StaticResource TextGray}" FontFamily="PoppinsRegular" />
                                    <Label Text="{Binding TotalClientsCount}" FontSize="22" FontFamily="PoppinsBold" TextColor="#1565C0" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>

                        <Frame x:Name="StatCard4" Grid.Column="3" Style="{StaticResource StatFrame}">
                            <HorizontalStackLayout Spacing="15">
                                <Frame HeightRequest="48" WidthRequest="48" CornerRadius="24" BackgroundColor="#FFF3E0" Padding="12" HasShadow="False" BorderColor="Transparent">
                                    <Label Text="🔒" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Frame>
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="Protected" FontSize="12" TextColor="{StaticResource TextGray}" FontFamily="PoppinsRegular" />
                                    <Label Text="{Binding ProtectedAccountsCount}" FontSize="22" FontFamily="PoppinsBold" TextColor="{StaticResource PrimaryOrange}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- 3. SEARCH BAR -->
                    <Frame BackgroundColor="White" CornerRadius="18" Padding="15,0" HeightRequest="56" HasShadow="True" BorderColor="{StaticResource BorderOrange}" Margin="20,10">
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Text="🔍" VerticalOptions="Center" Margin="0,0,12,0" TextColor="{StaticResource TextGray}" Opacity="0.7" />
                            <Entry Grid.Column="1" Placeholder="Search users by name, email or role..." 
                                   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceEventName=TextChanged}"
                                   TextColor="{StaticResource TextDark}"
                                   FontFamily="PoppinsRegular"
                                   VerticalOptions="Center"
                                   BackgroundColor="Transparent" />
                        </Grid>
                    </Frame>

                    <!-- 4. USER GRID -->
                    <FlexLayout x:Name="UsersFlexLayout"
                                BindableLayout.ItemsSource="{Binding FilteredUsers}"
                                Wrap="Wrap"
                                JustifyContent="Start"
                                AlignItems="Start"
                                AlignContent="Start"
                                Padding="15">
                        <BindableLayout.EmptyView>
                            <VerticalStackLayout Padding="100" Spacing="20" HorizontalOptions="Center" WidthRequest="600">
                                <Label Text="👥" FontSize="60" HorizontalOptions="Center" Opacity="0.2" />
                                <Label Text="No accounts found." TextColor="{StaticResource TextGray}" FontFamily="PoppinsBold" FontSize="18" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </BindableLayout.EmptyView>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="model:UserAccount">
                                <Frame Style="{StaticResource UserGridFrame}" Margin="5">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="AdaptiveStates">
                                            <VisualState x:Name="DesktopState">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="900" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Property="FlexLayout.Basis" Value="24%" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="TabletState">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="600" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Property="FlexLayout.Basis" Value="48%" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="MobileState">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="0" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Property="FlexLayout.Basis" Value="100%" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <VerticalStackLayout Spacing="15" VerticalOptions="Center">
                                        <Frame HeightRequest="80" WidthRequest="80" CornerRadius="40" HorizontalOptions="Center" Padding="0" HasShadow="False" BorderColor="{StaticResource BorderOrange}" BackgroundColor="{StaticResource CreamWhite}">
                                            <Image Source="users_icon.png" Margin="20" Aspect="AspectFit" />
                                        </Frame>

                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding FullName}" FontSize="18" FontFamily="PoppinsBold" TextColor="{StaticResource TextDark}" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Email}" FontSize="12" TextColor="{StaticResource TextGray}" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation" FontFamily="PoppinsRegular" />
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                            <Frame BackgroundColor="{StaticResource BorderOrange}" Padding="10,4" CornerRadius="12" HasShadow="False" BorderColor="Transparent">
                                                <Label Text="{Binding Role}" FontSize="10" FontFamily="PoppinsBold" TextColor="{StaticResource PrimaryOrange}" CharacterSpacing="1" />
                                            </Frame>
                                            <Frame BackgroundColor="#F5F5F5" Padding="10,4" CornerRadius="12" HasShadow="False" BorderColor="Transparent">
                                                <Label Text="ACTIVE" FontSize="10" FontFamily="PoppinsBold" TextColor="#BDBDBD" CharacterSpacing="1" />
                                            </Frame>
                                        </HorizontalStackLayout>

                                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderOrange}" Opacity="0.5" Margin="0,5" />

                                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" IsVisible="{Binding IsNotAdmin}">
                                            <Button Text="👁" Style="{StaticResource CircleActionBtn}" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageUsersViewModel}}, Path=ViewUserCommand}"
                                                    CommandParameter="{Binding .}" ToolTipProperties.Text="View Profile" />
                                            <Button Text="✎" Style="{StaticResource CircleActionBtn}" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageUsersViewModel}}, Path=EditUserCommand}"
                                                    CommandParameter="{Binding .}" ToolTipProperties.Text="Edit User" />
                                            <Button Text="🗑" Style="{StaticResource CircleActionBtn}" 
                                                    BackgroundColor="#FFE5E5" TextColor="#D32F2F"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManageUsersViewModel}}, Path=DeleteUserCommand}"
                                                    CommandParameter="{Binding .}" ToolTipProperties.Text="Delete User" />
                                        </HorizontalStackLayout>

                                        <Frame IsVisible="{Binding IsAdmin}" 
                                               BackgroundColor="#FDF5F0" 
                                               BorderColor="#FFE4CC" 
                                               Padding="10,8" 
                                               CornerRadius="15" 
                                               HasShadow="False">
                                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                                <Label Text="🔒" FontSize="14" VerticalOptions="Center" />
                                                <Label Text="System Protected" 
                                                       TextColor="#FF8200" 
                                                       FontSize="11" 
                                                       FontFamily="PoppinsBold" 
                                                       VerticalOptions="Center" 
                                                       CharacterSpacing="0.5" />
                                            </HorizontalStackLayout>
                                        </Frame>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
