<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PetCare.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PetCare"
    xmlns:admin="clr-namespace:PetCare.Page.Admin"
    xmlns:client="clr-namespace:PetCare.Page.Client"
    Title="PetCare">

    <!-- Auth Flow (Default) -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate local:Page.LoginPage}"
        Route="LoginPage" />

    <!-- App Roots (Hidden from direct tab navigation if needed) -->
    <ShellContent
        Title="Admin Dashboard"
        ContentTemplate="{DataTemplate admin:AdminDashboard}"
        Route="AdminDashboard" />

    <ShellContent
        Title="Client Dashboard"
        ContentTemplate="{DataTemplate client:ClientDashboard}"
        Route="ClientDashboard" />

</Shell>
