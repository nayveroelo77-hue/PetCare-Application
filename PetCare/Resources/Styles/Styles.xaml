<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="PoppinsRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="TextColor" Value="{StaticResource TextWhite}" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="FontFamily" Value="PoppinsBold" />
        <Setter Property="LineHeight" Value="1.1" />
    </Style>

    <Style TargetType="Label" x:Key="SubHeadline">
        <Setter Property="TextColor" Value="{StaticResource TextGray}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="PoppinsRegular" />
    </Style>

    <Style TargetType="Frame" x:Key="GlassCard">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{StaticResource GlassBorder}" />
        <Setter Property="CornerRadius" Value="30" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#26FFFFFF" Offset="0" />
                <GradientStop Color="#0DFFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>

    <Style TargetType="Label" x:Key="DashboardTitle">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontFamily" Value="PoppinsBold" />
    </Style>

    <Style TargetType="Label" x:Key="DashboardStatValue">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontFamily" Value="PoppinsBold" />
    </Style>

    <Style TargetType="Label" x:Key="DashboardStatLabel">
        <Setter Property="TextColor" Value="{StaticResource TextGray}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="PoppinsRegular" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style TargetType="Entry" x:Key="ModernInput">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextGray}" />
        <Setter Property="FontFamily" Value="PoppinsRegular" />
        <Setter Property="HeightRequest" Value="55" />
        <Setter Property="BackgroundColor" Value="#1AFFFFFF" />
        <Setter Property="Margin" Value="0,5" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="PoppinsRegular" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="PoppinsRegular" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="PoppinsRegular" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="PoppinsRegular" />
    </Style>

    <Style TargetType="Frame" x:Key="ModernInputFrame">
        <Setter Property="BackgroundColor" Value="#1AFFFFFF" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="55" />
        <Setter Property="Padding" Value="15,0" />
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="BackgroundColor" Value="{StaticResource CyanBright}" />
        <Setter Property="TextColor" Value="{StaticResource Tertiary}" />
        <Setter Property="FontFamily" Value="PoppinsBold" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="55" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource White}" />
                            <Setter Property="Scale" Value="1.02" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="BackgroundColor" Value="#26FFFFFF" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BorderColor" Value="{StaticResource White}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="FontFamily" Value="PoppinsBold" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="55" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#4DFFFFFF" />
                            <Setter Property="Scale" Value="1.02" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource CyanBright}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="Button" x:Key="GhostButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BorderColor" Value="{StaticResource White}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="FontFamily" Value="PoppinsRegular" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="55" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#1AFFFFFF" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource RoyalBlue}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource White}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource White}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource RoyalBlue}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource White}" />
    </Style>

</ResourceDictionary>
